{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "S1 observation receipt draft v1; source verification required",
  "type": "object", "additionalProperties": false,
  "required": ["version", "run_id", "task_id", "instance_id", "scope_id", "storage_kind", "window", "state", "method", "collector_version", "started_at", "completed_at", "enumeration_complete", "instance_verified", "control_passed", "control_cleaned", "item_count", "evidence_refs", "control_refs", "errors"],
  "properties": {
    "version": {"const": "okb-observation-receipt-v1-draft"},
    "run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "instance_id": {"type": "string", "minLength": 1},
    "scope_id": {"type": "string", "minLength": 1},
    "storage_kind": {"enum": ["file", "api", "database", "event_stream"]},
    "window": {"enum": ["before", "after", "whole_task"]},
    "state": {"enum": ["complete_nonempty", "complete_empty", "partial", "unavailable", "error"]},
    "method": {"type": "string", "minLength": 1},
    "collector_version": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "enumeration_complete": {"type": "boolean"},
    "instance_verified": {"type": "boolean"},
    "control_passed": {"type": "boolean"},
    "control_cleaned": {"type": "boolean"},
    "item_count": {"type": ["integer", "null"], "minimum": 0},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "control_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "errors": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
