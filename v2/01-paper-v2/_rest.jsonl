{"id":"v2_tr_strong_invoice_rule_001","dimension":"task_reuse","difficulty":"L3","title":"长话题链后应用报销规则完成合规检查","tags":["cross_session","multi_turn","has_fixture","has_gold_evidence"],"script":[{"session":"s1","phase":"write","turns":[{"text":"报销规则：金额超过 1000 的必须附发票。"}]},{"session":"s2","phase":"disturb","turns":[{"text":"帮我查一下明天限行吗？车牌尾号 3。"}]},{"session":"s3","phase":"disturb","turns":[{"text":"把这句话翻译一下：时间就是金钱。"}]},{"session":"s4","phase":"disturb","turns":[{"text":"今天天气不错。"}]},{"session":"s5","phase":"probe","turns":[{"text":"检查 报销单2.yaml 是否合规；不合规就把“需附发票”写进备注栏。"}]}],"fixture":[{"path":"报销单2.yaml","content":"金额: 1200\n附件: 无\n备注: \n"}],"anchors":[{"id":"A1","type":"memory_entry","key_regex":".*","expect":"present","severity":"hard","on_violation":"omitted","desc":"结构护栏：后态存在至少一条持久记忆"},{"id":"A2","type":"file_content","path":"报销单2.yaml","field_path":"备注","content_regex":"需附发票","expect":"present","severity":"hard","on_violation":"omitted","desc":"不合规结论按任务写入备注"},{"id":"A3","type":"file_content","path":"报销单2.yaml","field_path":"备注","content_regex":"合规","expect":"absent","severity":"hard","on_violation":"confused","evaluate_at":"snapshot_after","desc":"不得给出“合规”结论"},{"id":"A4","type":"reply_text","turn":"s5.t1","regex":".+","expect":"present","severity":"hard","on_violation":"omitted","desc":"结构护栏：探测轮有非空回复"}],"expect":{"verdict":"remembered","reference_answer":["该单不合规（金额 1200 无发票），备注写入“需附发票”"],"gold_evidence":["s1.t1"],"confusions":["omitted","confused"],"trap":["合规"],"notes":"误判合规=confused（A3 承接）；漏写备注=omitted。"},"score_policy":"hybrid","meta":{"author":"A-side v2 (draft)","created":"2026-10-09","source":"handcrafted","limitation":"强扰动槽（写探间 3 个不同话题会话）。","suite_version":"v2.0"}}
